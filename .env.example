# ==============================================================================
# MessConnect Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR CREDENTIALS BEFORE RUNNING
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL
# ==============================================================================

# Server Environment & Ports
NODE_ENV=production
PORT=5000
FLASK_PORT=5000

# Security Keys
SECRET_KEY=replace_with_a_long_random_jwt_secret_token_at_least_64_characters

# CORS Configuration (comma-separated allowed origins for production)
ALLOWED_ORIGINS=https://messconnect.in,https://app.messconnect.in,http://localhost:5173,http://localhost:3000

# MySQL Database Credentials
DB_HOST=your_mysql_host_or_cloud_cluster
DB_PORT=3306
DB_USER=your_mysql_username
DB_PASSWORD=your_secure_mysql_database_password_here
DB_NAME=messconnectproject
DB_SSL=REQUIRED
DB_SSL_REJECT_UNAUTHORIZED=false

# Razorpay Payment Gateway
# Get keys from Razorpay Dashboard: Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ==============================================================================
# Transactional Email Gateway (Google Gmail SMTP with Nodemailer)
# ==============================================================================
# Mandatory Gmail SMTP Variables:
# For Gmail, EMAIL_PASS must be the 16-character Google App Password generated at:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification ON in Google Account)
EMAIL_USER=your_gmail_address_here@gmail.com
EMAIL_PASS=your_16_digit_google_app_password_here
EMAIL_SENDER_NAME="MessConnect Verification"

# Outbound Gmail SMTP Settings (Port 587 STARTTLS is required for cloud hosting):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Fallback alias names supported:
GMAIL_USER=your_gmail_address_here@gmail.com
GMAIL_APP_PASS=your_16_digit_google_app_password_here


